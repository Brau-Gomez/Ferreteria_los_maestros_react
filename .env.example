# Ferretería Los Maestros - Frontend Environment Variables
# Copia este archivo a .env (y .env.production para builds de producción).
# VITE_* se expone en el bundle del navegador: nunca pongas secretos aquí.

# URL base de la API (el gateway expone /api)
VITE_API_URL=http://localhost:8180/api

# Nombre de la aplicación (solo informativo)
VITE_APP_NAME=Ferretería Los Maestros

# Contraseña que rellenan los botones de acceso demo.
# VITE_* se expone en el bundle: usar solo credenciales de demostración, nunca secretos reales.
VITE_DEMO_PASSWORD=
